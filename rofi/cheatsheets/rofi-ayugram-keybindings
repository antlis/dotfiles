  [message]="Message"
  [message_silently]="Silent Message"
  [message_scheduled]="Scheduled Message"
  [media_viewer_video_fullscreen]="Video Fullscreen"
  [show_scheduled]="Scheduled Messages"
  [archive_chat]="Archive Chat"
  [record_round]="Record Round Video"
  [reaction_send]="Send Reaction"
  [scroll_to_unread]="Scroll to Unread"
