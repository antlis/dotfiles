rows+=("")
rows+=("── Editing ──")
rows+=("$(printf '%-24s %s' "Up" "Edit Last Message")")
rows+=("$(printf '%-24s %s' "Ctrl+Z" "Undo")")
rows+=("$(printf '%-24s %s' "Ctrl+Shift+Z" "Redo")")
